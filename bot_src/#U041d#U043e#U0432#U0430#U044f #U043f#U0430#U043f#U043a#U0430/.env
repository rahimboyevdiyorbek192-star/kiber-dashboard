# ══════════════════════════════════════════
# ASOSIY SOZLAMALAR (majburiy)
# ══════════════════════════════════════════
API_ID=
API_HASH=
BOT_TOKEN=
SUPER_ADMIN_ID=
ADMIN_IDS=

# ══════════════════════════════════════════
# 1-USERBOT PROXY (ixtiyoriy)
# Format: socks5://user:pass@ip:port
#         socks4://ip:port
#         http://user:pass@ip:port
# Bo'sh qoldirilsa — proxy ishlatilmaydi
# ══════════════════════════════════════════
USERBOT1_PROXY=

# ══════════════════════════════════════════
# N-USERBOT TIZIMI — CHEKSIZ
#
# HAR USERBOT UCHUN ALOHIDA API_ID/HASH KERAK!
# Sabab: bir API_ID dan ko'p session → Telegram ban qiladi
#
# Qanday olish:
#   1. my.telegram.org ga O'SHA USERBOT ning telefoni bilan kiring
#   2. "API development tools" → yangi app yarating
#   3. API_ID va API_HASH ni ko'chiring
#
# Bo'sh qolgan birinchi USERBOT{N}_PHONE da to'xtaydi (cheksiz)
# ══════════════════════════════════════════

# ── 2-USERBOT ────────────────────────────
USERBOT2_PHONE=
USERBOT2_API_ID=
USERBOT2_API_HASH=
USERBOT2_PROXY=

# ── 3-USERBOT ────────────────────────────
USERBOT3_PHONE=
USERBOT3_API_ID=
USERBOT3_API_HASH=
USERBOT3_PROXY=

# ── 4-USERBOT ────────────────────────────
USERBOT4_PHONE=
USERBOT4_API_ID=
USERBOT4_API_HASH=
USERBOT4_PROXY=

# ── 5-USERBOT ────────────────────────────
USERBOT5_PHONE=
USERBOT5_API_ID=
USERBOT5_API_HASH=
USERBOT5_PROXY=

# Keyingisi kerak bo'lsa — xuddi shunday davom eting:
# USERBOT6_PHONE=
# USERBOT6_API_ID=
# USERBOT6_API_HASH=
# USERBOT6_PROXY=

# ══════════════════════════════════════════
# HAVOLA TEKSHIRISH API KALITLARI (ixtiyoriy)
# ══════════════════════════════════════════

# VirusTotal — URL, APK, OGG hash tekshirish (kuniga 500 bepul)
# Ro'yxatdan o'tish: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# AbuseIPDB — IP manzil obro'sini tekshirish (oyiga 1000 bepul)
# Ro'yxatdan o'tish: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Hybrid Analysis — APK ni Android 8.1 sandbox da ishlatib tahlil (bepul)
# Ro'yxatdan o'tish: https://www.hybrid-analysis.com/my-account?tab=%23api-key-tab
HYBRID_ANALYSIS_API_KEY=
