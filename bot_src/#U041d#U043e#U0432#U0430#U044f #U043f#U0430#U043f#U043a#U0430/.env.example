# ════════════════════════════════════════════════════
#   KIBER STANSIYA — .env sozlamalari
#   Bu faylni nusxalab ".env" deb saqlang
# ════════════════════════════════════════════════════

# ── 1-USERBOT + BOT (MAJBURIY) ───────────────────────
# my.telegram.org ga 1-telefon bilan kiring → API_ID, API_HASH oling
API_ID=
API_HASH=

# @BotFather dan
BOT_TOKEN=

# @userinfobot ga /start → sizning ID
SUPER_ADMIN_ID=

# Qo'shimcha adminlar (vergul bilan, ixtiyoriy)
ADMIN_IDS=

# ════════════════════════════════════════════════════
# N-USERBOT TIZIMI — CHEKSIZ
#
# HAR USERBOT UCHUN ALOHIDA API_ID/HASH KERAK!
# Sabab: bir API_ID dan ko'p session → Telegram ban qiladi
#
# Qanday olish:
#   1. my.telegram.org ga O'SHA USERBOT ning telefoni bilan kiring
#   2. "API development tools" → yangi app yarating
#   3. API_ID va API_HASH ni ko'chiring
#
# Bo'sh qolgan birinchi USERBOT{N}_PHONE da to'xtaydi (cheksiz)
# ════════════════════════════════════════════════════

# ════════════════════════════════════════════════════
# PROXY SOZLAMALARI (ixtiyoriy)
#
# Har userbot uchun alohida proxy belgilash mumkin.
# Format: socks5://user:pass@ip:port
#         socks4://ip:port
#         http://user:pass@ip:port
# Bo'sh qoldirilsa — proxy ishlatilmaydi.
#
# Proxy uchun PySocks kerak: pip install PySocks
# ════════════════════════════════════════════════════

# ── 1-USERBOT PROXY (asosiy) ─────────────────────────
USERBOT1_PROXY=
# Misol: USERBOT1_PROXY=socks5://user:pass@1.2.3.4:1080

# ── 2-USERBOT ────────────────────────────────────────
# my.telegram.org ga 2-telefon bilan kiring
USERBOT2_PHONE=
USERBOT2_API_ID=
USERBOT2_API_HASH=
USERBOT2_PROXY=

# ── 3-USERBOT ────────────────────────────────────────
USERBOT3_PHONE=
USERBOT3_API_ID=
USERBOT3_API_HASH=
USERBOT3_PROXY=

# ── 4-USERBOT ────────────────────────────────────────
USERBOT4_PHONE=
USERBOT4_API_ID=
USERBOT4_API_HASH=
USERBOT4_PROXY=

# ── 5-USERBOT ────────────────────────────────────────
USERBOT5_PHONE=
USERBOT5_API_ID=
USERBOT5_API_HASH=
USERBOT5_PROXY=

# ── 6-USERBOT ────────────────────────────────────────
USERBOT6_PHONE=
USERBOT6_API_ID=
USERBOT6_API_HASH=
USERBOT6_PROXY=

# ── 7-USERBOT ────────────────────────────────────────
USERBOT7_PHONE=
USERBOT7_API_ID=
USERBOT7_API_HASH=
USERBOT7_PROXY=

# ── 8-USERBOT ────────────────────────────────────────
USERBOT8_PHONE=
USERBOT8_API_ID=
USERBOT8_API_HASH=
USERBOT8_PROXY=

# ── 9-USERBOT ────────────────────────────────────────
USERBOT9_PHONE=
USERBOT9_API_ID=
USERBOT9_API_HASH=
USERBOT9_PROXY=

# ── 10-USERBOT ───────────────────────────────────────
USERBOT10_PHONE=
USERBOT10_API_ID=
USERBOT10_API_HASH=
USERBOT10_PROXY=

# 10 dan ko'p kerak bo'lsa — xuddi shunday davom eting:
# USERBOT11_PHONE=
# USERBOT11_API_ID=
# USERBOT11_API_HASH=
# USERBOT11_PROXY=


# ══════════════════════════════════════════
# 🛡 HAVOLA TEKSHIRISH API KALITLARI (ixtiyoriy)
# ══════════════════════════════════════════

# VirusTotal — URL, APK, OGG hash tekshirish (kuniga 500 bepul)
# Ro'yxatdan o'tish: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# AbuseIPDB — IP manzil obro'sini tekshirish (oyiga 1000 bepul)
# Ro'yxatdan o'tish: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Hybrid Analysis — APK ni Android 8.1 sandbox da ishlatib tahlil (bepul)
# Ro'yxatdan o'tish: https://www.hybrid-analysis.com/my-account?tab=%23api-key-tab
HYBRID_ANALYSIS_API_KEY=

# ════════════════════════════════════════════════════
# ESLATMA:
#   - Bu faylni ".env" deb saqlang (nusxa ko'chiring)
#   - Hech kimga bermang — shaxsiy ma'lumotlar bor!
#   - Windows: Notepad → Saqlash → ".env"
#              Fayl turi: "Barcha fayllar (*.*)"
# ════════════════════════════════════════════════════

# ════════════════════════════════════════════════════
# 🐘 POSTGRESQL (ixtiyoriy — 100+ userbot uchun)
# Bo'sh qoldiring = SQLite (oddiy, 1-10 UB uchun)
# To'ldiring = PostgreSQL (server, 10+ UB uchun)
# ════════════════════════════════════════════════════
DATABASE_URL=
# Misol: DATABASE_URL=postgresql://postgres:parol@localhost:5432/kiber_station
